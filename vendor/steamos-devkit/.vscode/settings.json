    "editor.tokenColorCustomizations": {
        "comments": "#9ababa",
        "strings": "#9af5b4",
        "keywords": "#ffeaa7",
        "numbers": "#d7a6ff",
        "types": "#ffb89a",
        "functions": "#a6d9ff",
        "variables": "#e0f0f0",
        "textMateRules": [
            {"name": "Org headings", "scope": ["markup.heading", "entity.name.section"], "settings": {"foreground": "#ffeaa7", "fontStyle": "bold"}},
            {"name": "Org bold", "scope": ["markup.bold"], "settings": {"foreground": "#ffb89a", "fontStyle": "bold"}},
            {"name": "Org italic", "scope": ["markup.italic"], "settings": {"foreground": "#b4f5e0", "fontStyle": "italic"}},
            {"name": "Org links", "scope": ["markup.underline.link", "string.other.link"], "settings": {"foreground": "#a0f0f0", "fontStyle": "underline"}},
            {"name": "Org inline code", "scope": ["markup.raw", "markup.inline.raw"], "settings": {"foreground": "#b4f5e0"}},
            {"name": "Org code block", "scope": ["markup.fenced_code.block"], "settings": {"foreground": "#b4f5e0"}},
            {"name": "Org TODO", "scope": ["keyword.control.org.todo"], "settings": {"foreground": "#ff7b7b", "fontStyle": "bold"}},
            {"name": "Org DONE", "scope": ["keyword.control.org.done"], "settings": {"foreground": "#9af5b4", "fontStyle": "bold"}},
            {"name": "Org tags", "scope": ["entity.name.tag"], "settings": {"foreground": "#a6d9ff", "fontStyle": "bold"}},
            {"name": "Org dates", "scope": ["constant.other.date"], "settings": {"foreground": "#ffb89a"}},
            {"name": "Org priorities", "scope": ["constant.other.priority"], "settings": {"foreground": "#ffd166", "fontStyle": "bold"}}
        ]
    }
}
